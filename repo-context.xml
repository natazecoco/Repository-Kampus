                ->required()
                ->unique(ignoreRecord: true),

            Select::make('parent_id')
                ->label('Topik Induk')
                ->relationship('parent', 'name')
                ->searchable()
                ->preload()
                ->nullable(),

            TextInput::make('sort_order')

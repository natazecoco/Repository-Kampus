                    $table->string('category')->default('research');
                }
                if (! Schema::hasColumn('research_method_dictionaries', 'priority')) {
                    $table->unsignedInteger('priority')->default(50);
                }
            });
        }

        $now = now();
        $rows = [];
        foreach (config('research.methods', []) as $keyword => $label) {
            $rows[] = [
            'method_name' => $label,

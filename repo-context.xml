            ->defaultSort('created_at', 'desc')
            ->recordActions([
                Action::make('view_publication')
                    ->label('Baca Publikasi')
                    ->icon('heroicon-s-eye')
                    ->color('info')
                    ->url(fn ($record): string => route('publications.viewer', $record))
                    ->openUrlInNewTab()
